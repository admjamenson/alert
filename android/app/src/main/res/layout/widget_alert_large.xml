<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_alert_bg"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_large_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/widget_alert_label"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/widget_large_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/widget_large_logo"
        android:layout_toEndOf="@id/widget_large_logo"
        android:layout_marginStart="6dp"
        android:text="@string/widget_alert_label"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_large_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_large_logo"
        android:layout_marginTop="10dp"
        android:text="@string/widget_status_local"
        android:textColor="@color/widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/widget_large_bars"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_below="@id/widget_large_title"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <View
            android:id="@+id/widget_large_bar_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_green" />

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <View
            android:id="@+id/widget_large_bar_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_green" />

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <View
            android:id="@+id/widget_large_bar_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_green" />

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <View
            android:id="@+id/widget_large_bar_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_green" />

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <View
            android:id="@+id/widget_large_bar_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_green" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_large_target"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_below="@id/widget_large_bars"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/widget_alert_label"
        android:src="@drawable/ic_widget_target"
        android:tint="@color/widget_icon_tint" />

    <TextView
        android:id="@+id/widget_large_pill"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/widget_pill_green"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/widget_attention_area"
        android:textColor="@color/widget_text_inverse"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</RelativeLayout>
