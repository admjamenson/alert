ALERT_API_URL=http://localhost:5005
ALERT_APP_ENV=development

# Optional map/runtime flags injected by react-native-config.
AUTH_ANONYMOUS_ENABLED=false
MAP_PROVIDER=osm
MAPTILER_KEY=
MAP_STYLE_DEFAULT_URL=
MAP_STYLE_SATELLITE_URL=
MAP_SATELLITE_ENABLED=true
SECURITY_MAP_V2_ENABLED=true
POPUP_VALIDATION_ENABLED=false

# Mobile runtime contract
# - required for all backend-backed features (weather, epidemic, risk, entitlements, billing)
# - use an HTTPS origin in production
# - do not hardcode production hosts in TS/TSX files
# - do not put backend secrets, Stripe secret keys, service accounts, or provider auth here
