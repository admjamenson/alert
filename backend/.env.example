# REQUIRED - Core runtime / security
APP_ENV=development
PORT=5005
HOST=0.0.0.0
RELAY_HMAC_SECRET=replace_with_long_random_hmac_secret

# REQUIRED - Firebase for authenticated / billing persistence
FIREBASE_SERVICE_ACCOUNT=./firebase-admin.json

# REQUIRED - Billing / checkout runtime
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
APP_URL=http://localhost:5173
ALERT_BILLING_SESSION_SECRET=replace_with_long_random_secret

# OPTIONAL - Billing market overrides
STRIPE_PRICE_BY_CURRENCY_JSON={"USD":"price_usd_replace_me","EUR":"price_eur_replace_me","GBP":"price_gbp_replace_me","BRL":"price_brl_replace_me"}
STRIPE_PRICE_BY_COUNTRY_JSON={"CH":"price_chf_replace_me","JP":"price_jpy_replace_me"}
STRIPE_PRICE_BY_MARKET_TIER_JSON={"priority_city":"price_priority_city_replace_me"}
STRIPE_DEFAULT_COUNTRY=US
STRIPE_DEFAULT_CURRENCY=USD
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_BILLING_ADDRESS_COLLECTION=auto
STRIPE_TAX_ID_COLLECTION_ENABLED=false
ALERT_BILLING_ALLOW_QUERY_AUTH=true

# OPTIONAL - Entitlements / rollout
ALERT_PREMIUM_DEFAULT=false
ALERT_PREMIUM_USERS=
STARLINK_CONNECT_ROLLOUT_PERCENT=100
STARLINK_TUNNEL_ROLLOUT_PERCENT=0
STARLINK_EXCLUSIVE_ROLLOUT_PERCENT=100

# OPTIONAL - Feed providers / integrations
EPIDEMIC_BR_NOTIFICA_BASE_URL=https://notifica-prd-es.saude.gov.br
EPIDEMIC_BR_NOTIFICA_BASIC_AUTH=
WEATHER_FEED_USER_AGENT=AlertBackend/1.0 (+support@alertapp.com)
ROUTING_OSRM_BASE_URL=https://router.project-osrm.org/route/v1
ROUTING_PROVIDER_TIMEOUT_MS=2600
ROUTING_PROVIDER_RETRIES=1
ROUTING_PROVIDER_RETRY_DELAY_MS=180
ROUTING_PROVIDER_COOLDOWN_MS=45000
ROUTING_PROVIDER_FAILURE_THRESHOLD=3
ROUTING_PROVIDER_CACHE_TTL_MS=120000
ROUTING_PROVIDER_MAX_PER_MINUTE=120
ALERT_ALLOW_PUBLIC_PROVIDER_DEFAULTS=true

# OPTIONAL - Relay / chat
RELAY_TOKEN_TTL_SEC=900
GUARDIANS_CONVERSATION_ID=guardians-group

# OPTIONAL/PRODUCTION - External scale infrastructure
# Render service `alerta` must set ALERT_REDIS_URL to the provisioned private Redis URL.
ALERT_REDIS_URL=
ALERT_CACHE_DRIVER=memory
ALERT_JOB_QUEUE_DRIVER=memory
ALERT_REQUIRE_EXTERNAL_INFRA=false
ALERT_REDIS_CONNECT_TIMEOUT_MS=2500
ALERT_EVENT_CACHE_KEY_PREFIX=alert:event-hub
ALERT_SOS_FANOUT_QUEUE_ENABLED=true
ALERT_SOS_FANOUT_QUEUE_NAME=alert-sos-fanout
ALERT_SOS_FANOUT_CONCURRENCY=8
ALERT_SOS_FANOUT_ATTEMPTS=3
ALERT_SOS_FANOUT_BACKOFF_MS=500
ALERT_SOS_FANOUT_ENQUEUE_TIMEOUT_MS=1200

# OPTIONAL - Unit economics guardrails
ALERT_FREEMIUM_NET_AD_ARPU_USD=0.60
ALERT_PREMIUM_NET_SUBSCRIPTION_ARPU_USD=5.00
ALERT_PREMIUM_GROSS_BILLING_ARPU_USD=5.00
ALERT_ECONOMICS_PRICE_BOOK_PATH=
ALERT_ECONOMICS_PRICE_BOOK_JSON=
ALERT_ECONOMICS_STRICT_PRICEBOOK=false

# NOTES
# - never commit live Stripe keys or live relay secrets
# - FIREBASE_SERVICE_ACCOUNT may be a JSON string or a readable file path
# - RELAY_HMAC_SECRET is mandatory; backend bootstrap fails without it
# - EPIDEMIC_BR_NOTIFICA_BASIC_AUTH stays only on the backend and must never be shipped to mobile
# - ROUTING_OSRM_BASE_URL stays only on the backend; the mobile app must never call OSRM directly
# - set ALERT_CACHE_DRIVER=redis and ALERT_JOB_QUEUE_DRIVER=bullmq only when ALERT_REDIS_URL is configured
# - set ALERT_REQUIRE_EXTERNAL_INFRA=true in Render/staging when Redis/BullMQ must fail fast if misconfigured
# - set ALERT_ALLOW_PUBLIC_PROVIDER_DEFAULTS=false in production so missing provider URLs fail fast
# - use APP_URL=https://api.alert.app in production
# - do not use the retired host api.alertpremium.com
# - ALERT_BILLING_SESSION_SECRET should be a long random secret used to sign billing tokens
# - set ALERT_BILLING_ALLOW_QUERY_AUTH=false in production and pass a signed billing token instead
# - ALERT_ECONOMICS_STRICT_PRICEBOOK=true fails economics checks unless every mandatory cost has real or estimated_reliable origin
