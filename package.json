{
  "name": "alert",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "typecheck": "tsc --noEmit",
    "doctor:foundation": "node scripts/doctor-foundation.cjs",
    "doctor:ios": "node scripts/doctor-ios.cjs",
    "validate:foundation": "npm run doctor:foundation && npm run typecheck && npm run lint",
    "android:debug:device": "cd android && gradlew.bat assembleDebug --no-daemon",
    "android:debug:device:armeabi-v7a": "cd android && gradlew.bat assembleDebug --no-daemon -PreactNativeArchitectures=armeabi-v7a",
    "android:install:debug:device": "adb install --no-streaming -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:release:device": "cd android && gradlew.bat assembleRelease --no-daemon",
    "android:release:readiness": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/android-release-readiness.ps1",
    "store:readiness": "node scripts/store-release-readiness.cjs",
    "android:startup:release": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/android-startup-samples.ps1 -Samples 5",
    "android:build:native": "cd android && gradlew.bat assembleRelease",
    "android:install:native": "cd android && gradlew.bat installRelease",
    "android:rebuild:native": "cd android && gradlew.bat clean assembleRelease installRelease",
    "android:smoke:release": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/android-release-smoke.ps1",
    "ios": "react-native run-ios",
    "ios:validate:mac": "bash scripts/ios-macos-validation.sh",
    "lint": "eslint .",
    "test": "jest",
    "build": "cd android && gradlew.bat assembleRelease",
    "format": "prettier --write .",
    "check-deps": "depcheck",
    "clean": "cd android && gradlew.bat clean",
    "audit:worktree": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/audit-worktree.ps1",
    "review:scope:routing-final": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/review-scope.ps1 -ManifestPath docs\\release-scopes\\2026-04-09-routing-governance-final.txt -EmitCommands"
  },
